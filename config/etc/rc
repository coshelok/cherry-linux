#!/bin/sh
set -eu

log() {
    printf '\033[1;34m[RC]\033[0m %s\n' "$*"
}

log "Initializing Cherry Linux userspace"

hostname cherrylinux

mkdir -p /run /run/lock /tmp /var/tmp
chmod 0755 /run /run/lock
chmod 1777 /tmp /var/tmp

if [ -r /etc/os-release ]; then
    . /etc/os-release
    printf '\n  Welcome to %s\n' "${PRETTY_NAME:-Cherry Linux}"
    if [ -r /etc/motd ]; then
        cat /etc/motd
    fi
    printf '  System initialization complete.\n\n'
else
    printf '\n  Welcome to Cherry Linux\n'
    printf '  System initialization complete.\n\n'
fi

log "Userspace initialization complete"
