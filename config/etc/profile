# Cherry Linux system-wide shell environment.

export PATH="/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin"
export HOME="${HOME:-/root}"
export SHELL="/bin/sh"
export USER="${USER:-root}"
export EDITOR="${EDITOR:-vi}"
export PAGER="${PAGER:-less}"

case "${USER:-root}" in
    root)
        PS1='cherry:\w# '
        ;;
    *)
        PS1='cherry:\w$ '
        ;;
esac
export PS1
