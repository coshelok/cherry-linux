#!/bin/sh

RED='\033[1;31m'
GREEN='\033[1;32m'
WHITE='\033[1;37m'
RESET='\033[0m'

USER_HOST="${USER:-root}@$(hostname 2>/dev/null || echo "cherry")"
OS="Cherry Linux 0.4 $(uname -m)"
KERNEL=$(uname -r 2>/dev/null || echo "Unknown")

if [ -f /proc/uptime ]; then
    UPTIME_SEC=$(cut -d. -f1 /proc/uptime)
    UPTIME="$((UPTIME_SEC / 60)) mins"
else
    UPTIME="N/A"
fi

if [ -f /proc/meminfo ]; then
    MEM_TOTAL=$(awk '/MemTotal/ {print int($2/1024)}' /proc/meminfo)
    MEM_FREE=$(awk '/MemFree/ {print int($2/1024)}' /proc/meminfo)
    MEM_BUFFERS=$(awk '/Buffers/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 0)
    MEM_CACHED=$(awk '/^Cached/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 0)
    
    MEM_USED=$((MEM_TOTAL - MEM_FREE - MEM_BUFFERS - MEM_CACHED))
    RAM="${MEM_USED}MB / ${MEM_TOTAL}MB"
else
    RAM="N/A"
fi

echo -e "${GREEN}⠀⠀⠀⠀⢀⡽⡖⠀⠀⠀⠀⠀  ${WHITE}${USER_HOST}${RESET}"
echo -e "${GREEN}⠀⠀⠀⢠⠏⠀⢷⡀⠀⠀⠀⠀  ${WHITE}-----------${RESET}"
echo -e "${GREEN}⠀⠀⠀⡾⠁⠀⢈⣳⣤⣤⣄⠀  ${RED}OS:     ${RESET}${OS}"
echo -e "${RED}⢀⣶⣝⣿⣷⡄⣾⣾⣿⢿⣿⠆  ${RED}Kernel: ${RESET}${KERNEL}"
echo -e "${RED}⠘⣿⣿⣻⣿⡟⠙⠿⠽⠿⠋⠀  ${RED}Uptime: ${RESET}${UPTIME}"
echo -e "${RED}⠀⠈⠙⠛⠉⠀⠀⠀⠀⠀⠀⠀  ${RED}RAM:    ${RESET}${RAM}"
echo ""