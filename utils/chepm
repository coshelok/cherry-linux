#!/bin/sh
# Experimental regular-file packages. Only explicit, trusted SHA256s are accepted.
set -eu
ROOT=${CHEPM_ROOT:-/}
REPO_URL=${CHEPM_REPO_URL:-}
case "$ROOT" in /*) ;; *) echo 'CHEPM_ROOT must be absolute' >&2; exit 1 ;; esac
ROOT=$(cd "$ROOT" && pwd -P)
STATE="$ROOT/var/lib/chepm"
MANIFESTS="$STATE/manifests"
err() { echo "chepm: $*" >&2; exit 1; }
valid_path() {
    case "$1" in ''|/*|..|../*|*/../*|*/..|*//*|*[!a-zA-Z0-9_./+@=-]*|var/lib/chepm|var/lib/chepm/*) return 1 ;; esac
}
check_parents() {
    parent=${1%/*}
    while [ "$parent" != "$1" ] && [ "$parent" != . ]; do
        [ ! -L "$ROOT/$parent" ] || err "Symlink parent refused: $parent"
        [ ! -e "$ROOT/$parent" ] || [ -d "$ROOT/$parent" ] || err "Non-directory parent: $parent"
        case "$parent" in */*) parent=${parent%/*} ;; *) break ;; esac
    done
}
case "${1:-}" in
    --help|-h|'')
        echo 'Usage: chepm -ins NAME [ARCHIVE] SHA256 | -del NAME | -ls'
        echo 'Without ARCHIVE, CHEPM_REPO_URL must be an HTTPS repository.'
        echo 'Only regular files/directories; no overwrite, links, hooks or dependency resolution.'
        exit 0 ;;
    -ins|-del|-ls) action=$1 ;;
    *) err 'Unknown command; use --help' ;;
esac
if [ "$ROOT" = / ]; then [ "$(id -u)" = 0 ] || err 'Run as root'; fi
mkdir -p "$MANIFESTS"
mkdir "$STATE/lock" 2>/dev/null || err 'Another operation is running (or a stale lock needs recovery)'
tmp=''
cleanup() { [ -z "$tmp" ] || rm -rf -- "$tmp"; rmdir "$STATE/lock"; }
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
if [ "$action" = -ls ]; then
    find "$MANIFESTS" -maxdepth 1 -type f -printf '%f\n' | sort
    exit 0
fi
pkg=${2:-}
case "$pkg" in ''|.*|*[!a-zA-Z0-9_+.-]*) err 'Invalid package name' ;; esac
manifest="$MANIFESTS/$pkg"
if [ "$action" = -del ]; then
    [ -f "$manifest" ] || err 'Package is not installed'
    while IFS= read -r file; do
        valid_path "$file" || err 'Invalid manifest path'
        check_parents "$file"
    done < "$manifest"
    while IFS= read -r file; do rm -f -- "$ROOT/$file"; done < "$manifest"
    rm -f -- "$manifest"
    echo "Removed $pkg (shared directories retained)"
    exit 0
fi
[ ! -e "$manifest" ] || err 'Package is already installed'
[ ! -e "$STATE/$pkg.pending" ] || err 'Interrupted installation; inspect the .pending file before retrying'
tmp=$(mktemp -d "$STATE/stage.XXXXXX")
if [ "$#" = 4 ]; then archive=$3; expected=$4
elif [ "$#" = 3 ]; then
    expected=$3
    case "$REPO_URL" in https://*) ;; *) err 'CHEPM_REPO_URL must use HTTPS' ;; esac
    archive="$tmp/package.tar.gz"
    wget -q "$REPO_URL/$pkg.tar.gz" -O "$archive" || err 'Download failed'
else err 'Provide an archive and its trusted SHA256 (see --help)'
fi
case "$expected" in *[!0-9a-fA-F]*|'') err 'Invalid SHA256' ;; esac
[ "${#expected}" = 64 ] || err 'SHA256 must contain 64 hex digits'
printf '%s  %s\n' "$expected" "$archive" | sha256sum -c --status - || err 'Checksum mismatch'
gzip -t "$archive" || err 'Invalid gzip archive'
LC_ALL=C tar -tzf "$archive" > "$tmp/paths" || err 'Invalid tar archive'
LC_ALL=C tar -tvzf "$archive" > "$tmp/types" || err 'Invalid tar archive'
# Links and special files need richer package metadata; reject them explicitly.
awk 'substr($0,1,1)!="-" && substr($0,1,1)!="d" {bad=1} END {exit bad}' "$tmp/types" || err 'Only regular files and directories are supported'
while IFS= read -r file; do
    file=${file#./}; file=${file%/}
    [ -n "$file" ] && [ "$file" != . ] || continue
    valid_path "$file" || err "Unsafe archive path: $file"
    check_parents "$file"
done < "$tmp/paths"
mkdir "$tmp/root"
tar -xzf "$archive" -C "$tmp/root" --no-same-owner --no-same-permissions || err 'Extraction failed'
(cd "$tmp/root"; find . -type f -print | sed 's|^./||' | sort) > "$tmp/manifest"
[ -s "$tmp/manifest" ] || err 'Package contains no regular files'
while IFS= read -r file; do
    [ ! -e "$ROOT/$file" ] && [ ! -L "$ROOT/$file" ] || err "File conflict: $file"
done < "$tmp/manifest"
cp "$tmp/manifest" "$STATE/$pkg.pending"
: > "$tmp/installed"
failed=0
while IFS= read -r file; do
    mkdir -p -- "$(dirname "$ROOT/$file")" || { failed=1; break; }
    # Record before copying so a partial write is also removed on failure.
    printf '%s\n' "$file" >> "$tmp/installed"
    cp -p --no-preserve=ownership -- "$tmp/root/$file" "$ROOT/$file" &&
        chmod u-s,g-s -- "$ROOT/$file" || { failed=1; break; }
done < "$tmp/manifest"
if [ "$failed" = 1 ]; then
    while IFS= read -r file; do rm -f -- "$ROOT/$file"; done < "$tmp/installed"
    rm -f "$STATE/$pkg.pending"
    err 'Install failed; copied files rolled back'
fi
mv "$STATE/$pkg.pending" "$manifest"
echo "Installed $pkg"
